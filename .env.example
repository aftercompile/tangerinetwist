# Supabase Postgres — use the "Transaction pooler" URI (port 6543) for the app
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Postgres — use the "Session pooler" URI (port 5432) for drizzle-kit migrations
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth — generate with: npm run admin:hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Shiprocket — same login you use at shiprocket.in. SHIPROCKET_PICKUP_LOCATION is the
# pickup address nickname already registered under Settings > Pickup Addresses there.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Any random string you choose yourself, then paste into Shiprocket's Configure Webhook
# screen (Settings > API > Webhooks) alongside https://<your-domain>/api/webhooks/shiprocket
SHIPROCKET_WEBHOOK_SECRET=

# Razorpay — the primary checkout payment method (Settings > API Keys in your Razorpay
# dashboard; test-mode keys work with no KYC needed). RAZORPAY_WEBHOOK_SECRET is set
# separately when you add the webhook URL under Settings > Webhooks (point it at
# https://<your-domain>/api/webhooks/razorpay).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Fastrr Checkout by Shiprocket — the alternative payment option offered alongside
# Razorpay at checkout ("Or pay another way"): address, shipping, payment including COD,
# all hosted by Fastrr. Get these from Shiprocket's Fastrr onboarding team, not the
# Shiprocket dashboard itself (separate product/credentials from the fulfillment
# SHIPROCKET_* vars above). FASTRR_ENV picks the API base URL; register
# https://<your-domain>/api/webhooks/fastrr-order with their team as the order webhook.
FASTRR_ENV=production
FASTRR_API_KEY=
FASTRR_API_SECRET=
# Any random string you choose yourself, then add it on Fastrr's webhook registration
# screen as a header named exactly "x-api-key". Leave blank to skip the check entirely
# (the webhook is still safe either way — it only reads an order id from the payload and
# re-fetches the real order over our own signed API call).
FASTRR_WEBHOOK_SECRET=

# Google Analytics 4 — Admin > Data Streams > (your web stream) > Measurement ID.
# Storefront-only (see (storefront)/layout.tsx) so admin-panel usage never mixes
# into customer analytics. Leave blank to disable entirely (e.g. local dev).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Gemini API key — aistudio.google.com/apikey. Powers /admin/products/bulk-import's
# AI-drafted product listings (src/lib/gemini/client.ts), server-side only.
GEMINI_API_KEY=

# Google Places API (New) — address autocomplete at checkout and on the account page's
# address form (src/lib/google-places.ts). Client-side by design (NEXT_PUBLIC_), so
# restrict it by HTTP referrer in Google Cloud Console (Credentials > this key >
# Application restrictions) to your real domain(s) rather than keeping it secret.
# Requires the "Places API (New)" enabled on a billing-enabled Google Cloud project —
# free tier is generous (up to 70,000 calls/product/month in India as of writing).
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
